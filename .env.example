# Clave de Google AI Studio (https://aistudio.google.com/apikey)
# Solo se lee en el servidor (route handler). Nunca la expongas con el prefijo NEXT_PUBLIC_.
GEMINI_API_KEY=tu_api_key_de_google_ai_studio

# Opcional: modelo de Gemini (por defecto gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Permite subir una planificación en PDF para generar temas y preguntas (true / false)
PLANIFICACION_PDF_HABILITADA=true

# Proxies de confianza delante de la app (Vercel, nginx, Cloudflare…) para leer la IP real.
# 0 = conexión directa (por defecto). Con 1 o más, la IP sale de x-forwarded-for contando desde la derecha.
# PROXIES_CONFIABLES=0

# Tope global de solicitudes por minuto a cada endpoint, sumando todas las IP (por defecto 60).
# LIMITE_GLOBAL_POR_MINUTO=60
